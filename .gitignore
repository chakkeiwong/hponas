*.fls
*.fdb_latexmk

# Survey localresources (PDFs are large and not needed in git)
hpo-survey/.localresources/

# Temporary spike outputs
/tmp/
*.db

# Claude session state (local only, never commit)
.claude/

# Reconstructible local runtimes and caches survive host restarts.
.hponas-runtime/

mutants/
mutmut_junit.xml

# Released guard reservations and relocated local mutation workspaces.
emergency.reserve
mutants

